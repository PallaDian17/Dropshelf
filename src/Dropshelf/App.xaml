<Application x:Class="Dropshelf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- ThemeManager inserts Dark.xaml or Light.xaml at index 0 at startup. -->
                <ResourceDictionary Source="UI/Themes/Dark.xaml" />
                <ResourceDictionary Source="UI/Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <SolidColorBrush x:Key="AccentBrush" Color="#FF0A84FF" />
            <SolidColorBrush x:Key="AccentTextBrush" Color="White" />
            <SolidColorBrush x:Key="SelectionBrush" Color="#550A84FF" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
