<Window x:Class="Dropshelf.Shelf.InstantActionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Instant Actions" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        SizeToContent="WidthAndHeight" UseLayoutRounding="True"
        FontFamily="{StaticResource UiFont}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
    <Border x:Name="Bubble" Margin="12" CornerRadius="14" Padding="6" Background="{DynamicResource ShelfBackgroundBrush}"
            BorderBrush="{DynamicResource ShelfBorderBrush}" BorderThickness="1" Opacity="0" RenderTransformOrigin="0.5,0">
        <Border.RenderTransform>
            <TransformGroup>
                <ScaleTransform x:Name="BubbleScale" />
                <TranslateTransform x:Name="BubbleShift" />
            </TransformGroup>
        </Border.RenderTransform>
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="3" Opacity="0.3" Color="{DynamicResource ShadowColor}" />
        </Border.Effect>
        <StackPanel x:Name="Tiles" Orientation="Horizontal" />
    </Border>
</Window>
