<Window x:Class="Dropshelf.Shelf.ShelfWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Dropshelf.Core"
        xmlns:ui="clr-namespace:Dropshelf.UI"
        Title="Dropshelf" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        AllowDrop="True" UseLayoutRounding="True" SnapsToDevicePixels="True"
        FontFamily="{StaticResource UiFont}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"
        Width="180" Height="200">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <ui:InverseBoolToVisibilityConverter x:Key="InverseBoolToVis" />

        <DataTemplate x:Key="GridItemTemplate" DataType="{x:Type core:ShelfItem}">
            <StackPanel Width="88" Margin="0,2" ToolTip="{Binding DisplayName}">
                <Grid Width="64" Height="64" HorizontalAlignment="Center">
                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="32"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                </Grid>
                <TextBlock Text="{Binding DisplayName}" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                           TextWrapping="Wrap" MaxHeight="30" FontSize="11" Margin="2,4,2,0" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="ListItemTemplate" DataType="{x:Type core:ShelfItem}">
            <Grid Height="38">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Image Width="30" Height="30" Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" />
                <TextBlock Text="{Binding Glyph}" Style="{StaticResource Glyph}" FontSize="20" Foreground="{DynamicResource TextSecondaryBrush}"
                           Visibility="{Binding HasThumbnail, Converter={StaticResource InverseBoolToVis}}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="4,0,0,0">
                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="GridPanel">
            <WrapPanel />
        </ItemsPanelTemplate>
        <ItemsPanelTemplate x:Key="ListPanel">
            <VirtualizingStackPanel />
        </ItemsPanelTemplate>
    </Window.Resources>

    <Grid x:Name="Root" Margin="14">
        <Border x:Name="ShadowLayer" CornerRadius="16" Background="{DynamicResource ShelfBackgroundBrush}">
            <Border.Effect>
                <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.35" Color="{DynamicResource ShadowColor}" />
            </Border.Effect>
        </Border>

        <Border x:Name="Card" CornerRadius="16" Background="{DynamicResource ShelfBackgroundBrush}"
                BorderBrush="{DynamicResource ShelfBorderBrush}" BorderThickness="1">
            <Grid>
                <!-- ===== Stack view (collapsed shelf) ===== -->
                <Grid x:Name="StackView">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="32" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="36" />
                    </Grid.RowDefinitions>

                    <Grid Background="Transparent" MouseLeftButtonDown="OnTopBarMouseDown">
                        <Button x:Name="CloseButton" Style="{StaticResource IconButton}" Content="&#xE711;" FontSize="10"
                                HorizontalAlignment="Left" Margin="6,0,0,0" Click="OnCloseClick"
                                ToolTip="Close the shelf (hold Alt to clear its content)" />
                        <Border Width="28" Height="4" CornerRadius="2" Background="{DynamicResource TextTertiaryBrush}"
                                HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,6,0">
                            <TextBlock x:Name="PinGlyph" Text="&#xE840;" Style="{StaticResource Glyph}" FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,4,0" Visibility="Collapsed"
                                       ToolTip="Pinned shelf" />
                            <Button x:Name="MenuButton" Style="{StaticResource IconButton}" Content="&#xE70D;" Click="OnMenuClick"
                                    ToolTip="Perform tasks with the files in the shelf" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="StackArea" Grid.Row="1" Background="Transparent" Cursor="Hand"
                          MouseLeftButtonDown="OnStackMouseDown" MouseMove="OnStackMouseMove" MouseLeftButtonUp="OnStackMouseUp">
                        <Grid x:Name="StackHost" Width="116" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"
                              IsHitTestVisible="False" />
                        <StackPanel x:Name="EmptyState" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock Text="&#xE896;" Style="{StaticResource Glyph}" FontSize="22" Foreground="{DynamicResource TextTertiaryBrush}" />
                            <TextBlock Text="Drop files here" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,8,0,0"
                                       HorizontalAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Button x:Name="FooterPill" Grid.Row="2" Style="{StaticResource PillButton}" HorizontalAlignment="Center"
                            VerticalAlignment="Top" Click="OnFooterClick" MaxWidth="140" ToolTip="Show the files in this shelf">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="FooterDot" Width="7" Height="7" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed" />
                            <TextBlock x:Name="FooterText" TextTrimming="CharacterEllipsis" MaxWidth="104" />
                            <TextBlock Text="&#xE76C;" Style="{StaticResource Glyph}" FontSize="8" Margin="5,1,0,0"
                                       Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- ===== Detail view (expanded shelf) ===== -->
                <Grid x:Name="DetailView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="46" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Background="Transparent" MouseLeftButtonDown="OnTopBarMouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Margin="8,0,4,0" Click="OnBackToStack"
                                ToolTip="Show the previous screen" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center" IsHitTestVisible="False">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse x:Name="DetailDot" Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center" Visibility="Collapsed" />
                                <TextBlock x:Name="DetailTitle" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <TextBlock x:Name="DetailSubtitle" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="0,0,8,0">
                            <ToggleButton x:Name="GridToggle" Style="{StaticResource IconToggleButton}" Content="&#xF0E2;"
                                          Click="OnGridMode" ToolTip="Show files as icons" />
                            <ToggleButton x:Name="ListToggle" Style="{StaticResource IconToggleButton}" Content="&#xE8FD;"
                                          Click="OnListMode" ToolTip="Show files in a list" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE713;" Click="OnCustomizeClick" ToolTip="Customize this shelf" />
                            <Button Style="{StaticResource IconButton}" Content="&#xE712;" Click="OnMenuClick" ToolTip="Perform tasks with the files" />
                        </StackPanel>
                    </Grid>

                    <ListBox x:Name="ItemsList" Grid.Row="1" Margin="6,0,6,6" SelectionMode="Extended"
                             ItemTemplate="{StaticResource GridItemTemplate}" ItemsPanel="{StaticResource GridPanel}"
                             PreviewMouseLeftButtonDown="OnListPreviewMouseDown" PreviewMouseMove="OnListPreviewMouseMove"
                             PreviewMouseLeftButtonUp="OnListPreviewMouseUp" MouseDoubleClick="OnListDoubleClick"
                             ContextMenuOpening="OnListContextMenuOpening">
                        <ListBox.ContextMenu>
                            <ContextMenu />
                        </ListBox.ContextMenu>
                    </ListBox>
                </Grid>

                <!-- ===== Panel view (action settings, customize, command bar) ===== -->
                <Grid x:Name="PanelView" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid Background="Transparent" Margin="8,8,10,8" MouseLeftButtonDown="OnTopBarMouseDown">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Style="{StaticResource IconButton}" Content="&#xE72B;" Click="OnPanelBack" ToolTip="Back" />
                        <StackPanel Grid.Column="1" Margin="6,0" VerticalAlignment="Center" IsHitTestVisible="False">
                            <TextBlock x:Name="PanelTitle" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="PanelSubtitle" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                        </StackPanel>
                        <Button x:Name="PanelPrimary" Grid.Column="2" Style="{StaticResource AccentButton}" Content="Continue"
                                Padding="14,4" MinHeight="26" Click="OnPanelPrimary" IsDefault="True" />
                    </Grid>
                    <ContentControl x:Name="PanelHost" Grid.Row="1" Margin="12,0,12,12" Focusable="False" />
                </Grid>

                <!-- ===== Overlays ===== -->
                <Border x:Name="BusyOverlay" CornerRadius="15" Background="{DynamicResource OverlayBrush}" Visibility="Collapsed">
                    <StackPanel VerticalAlignment="Center" Margin="18">
                        <TextBlock x:Name="BusyText" Text="Working…" HorizontalAlignment="Center" Margin="0,0,0,10" />
                        <ProgressBar IsIndeterminate="True" Width="96" />
                        <Button Content="Cancel" HorizontalAlignment="Center" Margin="0,12,0,0" Click="OnCancelAction" />
                    </StackPanel>
                </Border>

                <Border x:Name="Toast" CornerRadius="10" Background="{DynamicResource MenuBackgroundBrush}"
                        BorderBrush="{DynamicResource MenuBorderBrush}" BorderThickness="1" VerticalAlignment="Bottom"
                        HorizontalAlignment="Center" Margin="8,0,8,8" Padding="10,6" Visibility="Collapsed" IsHitTestVisible="False">
                    <TextBlock x:Name="ToastText" TextWrapping="Wrap" TextAlignment="Center" FontSize="11" MaxWidth="300" />
                </Border>
            </Grid>
        </Border>

        <Border x:Name="DropHighlight" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource AccentBrush}"
                Visibility="Collapsed" IsHitTestVisible="False" />
    </Grid>
</Window>
