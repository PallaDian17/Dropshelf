<Window x:Class="Dropshelf.UI.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Dropshelf Quick Start Guide" Width="560" Height="460" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource WindowBackgroundBrush}"
        FontFamily="{StaticResource UiFont}" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center">
            <Border Width="132" Height="132" CornerRadius="30" Background="{DynamicResource CardBackgroundBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" HorizontalAlignment="Center">
                <TextBlock x:Name="Illustration" Style="{StaticResource Glyph}" FontSize="58" Foreground="{DynamicResource AccentBrush}" />
            </Border>
            <TextBlock x:Name="PageTitle" FontSize="22" FontWeight="SemiBold" TextAlignment="Center" Margin="0,24,0,8" TextWrapping="Wrap" />
            <TextBlock x:Name="PageText" Foreground="{DynamicResource TextSecondaryBrush}" TextAlignment="Center"
                       TextWrapping="Wrap" MaxWidth="440" LineHeight="20" />
            <StackPanel x:Name="Dots" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,22,0,0" />
        </StackPanel>

        <Grid Grid.Row="1">
            <Button x:Name="SkipButton" Content="Skip" HorizontalAlignment="Left" Click="OnSkip" MinWidth="80" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BackButton" Content="Back" Click="OnBack" MinWidth="80" Margin="0,0,8,0" />
                <Button x:Name="NextButton" Style="{StaticResource AccentButton}" Content="Next" Click="OnNext" MinWidth="110" Padding="16,6" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
